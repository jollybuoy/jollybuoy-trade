# Market data provider: yahoo (default) | mock
VITE_MARKET_DATA_PROVIDER=yahoo

# Yahoo Finance API base URL (dev uses Vite proxy at /api/yahoo)
# VITE_YAHOO_FINANCE_BASE_URL=https://your-proxy.example.com/yahoo

# Local IBKR paper trading-service API (dev only — not available on Netlify)
# Leave unset in production; the app will show "IBKR local backend not connected"
VITE_IBKR_API_URL=http://localhost:8000
